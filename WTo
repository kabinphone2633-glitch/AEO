-- ฟังก์ชันที่ 2: เปิด / ปิด เมนูหน้าจอ (Toggle Menu)
----------------------------------------------------
BtnToggleMenu.Name = "BtnToggleMenu"
BtnToggleMenu.Parent = ScreenGui
BtnToggleMenu.Position = UDim2.new(0.02, 0, 0.4, 0)
BtnToggleMenu.Size = UDim2.new(0, 80, 0, 35)
BtnToggleMenu.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
BtnToggleMenu.Text = "ZSYO⭐ (ซ่อน)"
BtnToggleMenu.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnToggleMenu.TextSize = 12

